# Copy this file to deployment/config/hardware.env on the AGX and edit it.
# Verified on S10 PRO-049 hardware on 2026-09-14.
ROS_DOMAIN_ID=0
S10_ROS_SETUP=/opt/ros/jazzy/setup.bash
S10_CONDA_ENV=
S10_PYTHON=python3
S10_AGX_WIRED_CONNECTION="Wired connection 1"
S10_AGX_ADDRESS=10.21.33.102/24
S10_ROBOT_ADDRESS=10.21.33.103
S10_FRONT_LIDAR_ADDRESS=10.21.33.201
S10_REAR_LIDAR_ADDRESS=10.21.33.202
